{
  "schema_version": 1,
  "engine_release": "7.0.0-complete-operational-engine",
  "timezone": "Asia/Seoul",
  "lookback_days": 365,
  "minimum_theme_count": 50,
  "minimum_source_families_for_phase1_observed": 2,
  "network": {
    "timeout_seconds": 25,
    "max_attempts": 3,
    "base_backoff_seconds": 2.0,
    "max_workers": 4,
    "user_agent": "IndustryBoomLeadingEngine/7.0 (GitHub Actions; public research dashboard)"
  },
  "sources": {
    "openalex": {
      "enabled": true,
      "base_url": "https://api.openalex.org/works",
      "source_family": "GLOBAL_RESEARCH",
      "documentation": "https://docs.openalex.org/api-entities/works"
    },
    "usaspending": {
      "enabled": true,
      "base_url": "https://api.usaspending.gov/api/v2/search/spending_by_award_count/",
      "source_family": "US_GOVERNMENT_AWARDS",
      "documentation": "https://api.usaspending.gov/docs/endpoints"
    },
    "gdelt": {
      "enabled": true,
      "base_url": "https://api.gdeltproject.org/api/v2/doc/doc",
      "source_family": "GLOBAL_NEWS_ATTENTION",
      "documentation": "https://blog.gdeltproject.org/gdelt-doc-2-0-api-debuts/"
    },
    "wikimedia": {
      "enabled": true,
      "base_url": "https://wikimedia.org/api/rest_v1/metrics/pageviews/per-article/en.wikipedia/all-access/user",
      "source_family": "GLOBAL_PUBLIC_READING_ATTENTION",
      "documentation": "https://doc.wikimedia.org/generated-data-platform/aqs/analytics-api/reference/page-views.html"
    }
  },
  "rules": {
    "never_fabricate_missing_values": true,
    "never_convert_phase1_signal_to_frozen_boom_score": true,
    "preserve_previous_cache_on_source_failure": true,
    "investment_use_allowed": false,
    "api_revision_risk_must_be_disclosed": true,
    "public_interest_is_relative_cross_sectional_score": true,
    "operational_score_is_not_frozen_v091_score": true
  },
  "public_interest_window_days": 30,
  "public_interest_history_days": 90
}
