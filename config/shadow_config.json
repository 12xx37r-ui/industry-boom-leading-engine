{
  "schema_version": 1,
  "engine_release": "2.0.0-github-shadow-ledger",
  "frozen_model_version": "0.9.1",
  "timezone": "Asia/Seoul",
  "input_file": "shadow_input/current_snapshot.json",
  "history_dir": "shadow_history",
  "dashboard_dir": "outputs/shadow",
  "max_input_age_days": 14,
  "minimum_theme_count": 7,
  "scorecard_horizons_months": [6, 12, 24],
  "investment_use_allowed": false,
  "rules": {
    "overwrite_history": false,
    "allow_future_as_of": false,
    "require_model_lock": true,
    "require_previous_gate": true,
    "stale_input_is_nonfatal": true
  }
}
