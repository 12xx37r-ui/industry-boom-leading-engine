{
  "schema_version": 1,
  "engine_release": "7.2.0-local-dynamic-candidate-guarded",
  "enabled": true,
  "max_theme_queries_per_run": 3,
  "documents_per_source": 5,
  "lookback_days": 90,
  "local_text_corpus": "data_cache/inbox/v3_text_documents.json",
  "promotion_rule": {
    "min_documents": 2,
    "min_source_families": 2,
    "min_periods": 2,
    "min_similarity": 0.15,
    "max_candidates": 20
  },
  "auto_add_allowed": false,
  "note": "Candidates are review-only until independently confirmed; no automatic theme or NAICS mutation."
}
